}%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% OmniGraffle Help 转换支持
% 样式规格取自帮助文档 css/graffle-screen.css(版心 520px):
%   - note/tip/warning: 5%黑底、6px彩色左边框(蓝/绿/橙)、右侧圆角、
%     框内首行为标签(Note/Tip/Warning), 小号字体
%   - profeature: 3px浅绿(#AFF9B3)圆角边框、白底、右上角 PRO 标签、可跨页
%   - sidebar: 4px灰(#CCC)圆角边框、白底
%   - 表格: 全边框(#CCC)、表头蓝底白字, 勾/叉用 art 内原图 og7_yes/og7_no.png
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\definecolor{ognoteblue}{HTML}{3A8EEC}
\definecolor{ogtipgreen}{HTML}{67BB35}
\definecolor{ogwarnorange}{HTML}{FD8919}
\definecolor{ogprogreen}{HTML}{AFF9B3}
\definecolor{ogheaderblue}{HTML}{1568A6}
\definecolor{ogboxbg}{HTML}{F2F2F2}
\definecolor{ogbordergray}{HTML}{CCCCCC}

\arrayrulecolor{ogbordergray}

% 提示框公共样式: 灰底 + 4.5pt(6px)彩色左边框 + 仅右侧圆角
\tcbset{
  og alertbox/.style={
    enhanced,
    colback=ogboxbg,
    colframe=ogboxbg,
    borderline west={4.5pt}{0pt}{#1},
    arc=1.2mm,
    sharp corners=west,
    boxsep=0pt,
    left=1.2em,
    right=0.8em,
    top=0.7em,
    bottom=0.7em,
    before skip balanced=12pt,
    after skip balanced=12pt,
    fontupper=\small,
  },
}

\newtcolorbox{ognote}{og alertbox=ognoteblue,
before upper={\bfseries Note\par}}
\newtcolorbox{ogtip}{og alertbox=ogtipgreen,
before upper={\bfseries Tip\par}}
\newtcolorbox{ogwarning}{og alertbox=ogwarnorange,
before upper={\bfseries Warning\par}}

% PRO 框: 浅绿圆角边框 + 右上角 PRO 标签; 内容较长, 允许跨页
\newtcolorbox{ogpro}{
  enhanced,
  breakable,
  colback=white,
  colframe=ogprogreen,
  boxrule=2pt,
  arc=1.5mm,
  left=1em,
  right=1em,
  top=1em,
  bottom=0.8em,
  before skip balanced=14pt,
  after skip balanced=14pt,
  title=PRO,
  fonttitle=\bfseries,
  coltitle=black!70,
  attach boxed title to top right={yshift=-2.5mm, xshift=-4mm},
  boxed title style={
    colback=ogprogreen,
    colframe=ogprogreen,
    boxsep=1mm,
    top=0.4mm,
    bottom=0.4mm,
    left=1.2mm,
    right=1.2mm,
  },
}

% 侧栏框: 灰色粗圆角边框、白底
\newtcolorbox{ogsidebar}{
  enhanced,
  breakable,
  colback=white,
  colframe=ogbordergray,
  boxrule=3pt,
  arc=2mm,
  left=15pt,
  right=15pt,
  top=12pt,
  bottom=12pt,
  before skip balanced=14pt,
  after skip balanced=14pt,
}

% 插图: #1 为相对当前版心宽度的比例(与 HTML 中 min(原图宽, 80%*520px)/520px 一致;
% 在列表/盒子内使用 \linewidth, 与 HTML 中图片按所在容器计比例的行为一致)
\newcommand{\ogfigure}[2]{%
  \begin{figure}[H]
    \centering
    \includegraphics[width=#1\linewidth,height=0.9\textheight,keepaspectratio]{#2}%
  \end{figure}%
}

% 行内图标: #1 尺寸选项(height=/width=), #2 文件路径;
% 在标题中使用时通过 texorpdfstring 保护 PDF 书签
\newcommand{\ogicon}[2]{%
\texorpdfstring{\raisebox{-0.4ex}{\includegraphics[height=#1]{#2}}}{}}
\newcommand{\ogiconw}[2]{%
\texorpdfstring{\raisebox{-0.4ex}{\includegraphics[width=#1]{#2}}}{}}

% 表格勾/叉(HTML 中 .yes::after/.no::after 引用的原图)
\newcommand{\ogyes}{\raisebox{-0.9ex}{\includegraphics[height=24pt]{res/og7_yes.png}}}
\newcommand{\ogno}{\raisebox{-0.8ex}{\includegraphics[height=21pt]{res/og7_no.png}}}

% 表格单元格内的代码: 可在任意字符处折行(注意: tabularx 扫描体内
% 不能使用 \path/\verb 等 verbatim 命令)
\newcommand{\ogcellcode}[1]{\texttt{\seqsplit{#1}}}

