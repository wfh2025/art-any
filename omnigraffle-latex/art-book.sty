% 版面: 适度加宽版心(原书约65字符/行), 并保证页眉有足够高度
\usepackage{geometry}
\geometry{a4paper, left=27mm, right=27mm, top=30mm, bottom=32mm,
headheight=15pt, headsep=8mm, footskip=12mm}

% 页眉: 标记以 \footnotesize 排版, 避免长章节标题溢出版心
% (ctex 会在 \begin{document} 时重设 \ps@headings, 故挂在 AtBeginDocument)
\AtBeginDocument{%
  \makeatletter
  \renewcommand{\ps@headings}{%
    \let\@oddfoot\@empty
    \let\@evenfoot\@empty
    \def\@evenhead{\thepage\hfil{\footnotesize\slshape\leftmark}}%
    \def\@oddhead{{\footnotesize\slshape\rightmark}\hfil\thepage}%
    \let\@mkboth\markboth
  }%
  \makeatother
  \pagestyle{headings}%
}

% dbg环境/命令
% 命令行查找package: texdoc float
